#include <winres.h>

WTGWizard ICON "..\\WTGWizard.Main\\Assets\\AppLogo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_NUMERIC
 PRODUCTVERSION VER_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WTGWizard"
            VALUE "FileDescription", "WTGWizard Launcher"
            VALUE "FileVersion", VER_STRING_Q
            VALUE "InternalName", "WTGWizard"
            VALUE "LegalCopyright", "GNU General Public License v3.0"
            VALUE "OriginalFilename", "WTGWizard.exe"
            VALUE "ProductName", "WTGWizard"
            VALUE "ProductVersion", VER_STRING_Q
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
