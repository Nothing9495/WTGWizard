<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WTGWizard.Pages.Steps.ImageConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uc="using:WTGWizard.UserControls"
      xmlns:cc="using:CommunityToolkit.WinUI.Controls"
      xmlns:ui="using:CommunityToolkit.WinUI"
      xmlns:lang="using:WTGWizard.Main.Language"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

  <ScrollViewer Padding="20,20,20,0">
    <StackPanel Margin="0,0,0,20" Spacing="32">
      <StackPanel Spacing="3">
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_ImageConfig_Title}"
         Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_ImageConfig_Desc}"
         Style="{ThemeResource BodyTextBlockStyle}"
         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_ImageConfig_InfoCardHeader}"
                  FontSize="14"
                  Margin="0,12,0,6"
                  FontWeight="SemiBold"/>
        <uc:ImageInfoCard x:Name="ImageInfoCard" />
        <uc:InfoBarPresenter x:Name="VerifyInfoBar" />

        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_ImageConfig_SelImgGroup}"
                          FontSize="14"
                          Margin="0,12,0,6"
                          FontWeight="SemiBold"/>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_ImageConfig_SelImg_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_ImageConfig_SelImg_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xF012;}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <uc:FilePickerControl x:Name="ImageFilePicker"
                                  FileTypeFilter=".wim;.esd"
                                  FileSelected="ImageFilePicker_FileSelected" 
                                  VerticalAlignment="Center">
              <uc:FilePickerControl.ButtonContent>
                <FontIcon FontSize="14" Glyph="&#xE8A5;" />
              </uc:FilePickerControl.ButtonContent>
            </uc:FilePickerControl>
            <TextBox Text="{x:Bind VM.Image.FilePath, Mode=OneWay}"
                     PlaceholderText="{x:Bind lang:Lang.Page_WizStep_ImageConfig_FilePathPlaceholder}"
                     IsReadOnly="True"
                     MinWidth="250"
                     VerticalAlignment="Center" />
          </StackPanel>
        </cc:SettingsCard>

        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_ImageConfig_SelIdx_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_ImageConfig_SelIdx_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xF2C7;}">
          <ComboBox x:Name="ImageIndexComboBox"
                    PlaceholderText="{x:Bind lang:Lang.Page_WizStep_ImageConfig_IdxCombo_Placeholder}"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    SelectionChanged="ImageIndexComboBox_SelectionChanged"/>
        </cc:SettingsCard>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

</Page>
