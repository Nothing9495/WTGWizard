<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WTGWizard.Pages.Steps.AdvancedOptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uc="using:WTGWizard.UserControls"
      xmlns:cc="using:CommunityToolkit.WinUI.Controls"
      xmlns:ui="using:CommunityToolkit.WinUI"
      xmlns:lang="using:WTGWizard.Main.Language"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

  <ScrollViewer Padding="{StaticResource StepPagePadding}" MaxWidth="{ThemeResource PageContentMaxWidth}">
    <StackPanel Spacing="4" Margin="{StaticResource PageContentBottomMargin}">
      <!-- 标题 -->
      <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_AdvOptions_Title}"
                   Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_AdvOptions_Desc}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

      <!-- ═══ 驱动集成 ═══ -->
      <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_AdvOptions_DriverGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_DriverEnabled_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_DriverEnabled_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE958;}">
        <ToggleSwitch IsOn="{x:Bind VM.Advanced.DriverEnabled, Mode=TwoWay}" />
      </cc:SettingsCard>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_DriverPath_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_DriverPath_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                         IsEnabled="{x:Bind VM.Advanced.DriverEnabled, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <uc:FolderPickerControl x:Name="DriversFolderPicker"
                                    VerticalAlignment="Center"
                                    FolderSelected="OnDriverFolderSelected">
            <uc:FolderPickerControl.ButtonContent>
              <FontIcon FontSize="14" Glyph="&#xE838;" />
            </uc:FolderPickerControl.ButtonContent>
          </uc:FolderPickerControl>
          <TextBox PlaceholderText="{x:Bind lang:Lang.Page_WizStep_AdvOptions_DriverPath_Placeholder}"
                     Text="{x:Bind VM.Advanced.DriverPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="250"
                     MaxWidth="400"/>
        </StackPanel>
      </cc:SettingsCard>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_ForceUnsigned_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_ForceUnsigned_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE730;}"
                         IsEnabled="{x:Bind VM.Advanced.DriverEnabled, Mode=OneWay}">
        <ToggleSwitch IsOn="{x:Bind VM.Advanced.ForceUnsigned, Mode=TwoWay}" />
      </cc:SettingsCard>

      <!-- ═══ 应答文件 ═══ -->
      <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_AdvOptions_AnsFileGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_AnsFile_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE946;}">
        <cc:SettingsCard.Content>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <InfoBadge x:Name="AnsFileBadge"
                         Style="{x:Bind VM.Advanced.AnsFileBadgeStyle, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind VM.Advanced.AnsFileExistsDisplay, Mode=OneWay}"/>
          </StackPanel>
        </cc:SettingsCard.Content>
        <cc:SettingsCard.Description>
          <TextBlock Text="{x:Bind VM.Advanced.AnsFileDescriptionFull, Mode=OneWay}"
                       TextWrapping="Wrap"/>
        </cc:SettingsCard.Description>
      </cc:SettingsCard>
      <InfoBar Title="{x:Bind lang:Lang.InfoBar_InImageAnsFile_Title}"
                 IsClosable="False"
                 IsOpen="{x:Bind VM.Image.HasUnattend, Mode=OneWay}"
                 Message="{x:Bind lang:Lang.InfoBar_InImageAnsFile_Message}"
                 Severity="Informational" />
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_ExtractAnsFile_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_ExtractAnsFile_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE8C8;}">
        <Button Content="{x:Bind lang:Lang.Page_WizStep_AdvOptions_ExtractAnsFile_Button}"
                  Click="ExtractImageAnsFile_Click"
                  IsEnabled="{x:Bind VM.Image.HasUnattend, Mode=OneWay}" />
      </cc:SettingsCard>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_CustomAnsFile_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_CustomAnsFile_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE8B5;}">
        <ToggleSwitch IsOn="{x:Bind VM.Advanced.CustomAnsFileEnabled, Mode=TwoWay}" />
      </cc:SettingsCard>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_SelectAnsFile_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_SelectAnsFile_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}"
                         IsEnabled="{x:Bind VM.Advanced.CustomAnsFileEnabled, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <uc:FilePickerControl x:Name="AnsFilePicker"
                                  FileTypeFilter=".xml"
                                  VerticalAlignment="Center"
                                  FileSelected="OnAnsFileSelected">
            <uc:FilePickerControl.ButtonContent>
              <FontIcon FontSize="14" Glyph="&#xE8A5;" />
            </uc:FilePickerControl.ButtonContent>
          </uc:FilePickerControl>
          <TextBox PlaceholderText="{x:Bind lang:Lang.Page_WizStep_AdvOptions_AnsFilePath_Placeholder}"
                     Text="{x:Bind VM.Advanced.AnsFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxWidth="400"
                     MinWidth="250"/>
        </StackPanel>
      </cc:SettingsCard>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_CleanAnsFile_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_CleanAnsFile_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE74D;}"
                         IsEnabled="{x:Bind VM.Advanced.CustomAnsFileEnabled, Mode=OneWay}">
        <ToggleSwitch IsOn="{x:Bind VM.Advanced.CleanImageAnsFile, Mode=TwoWay}" />
      </cc:SettingsCard>

      <!-- ═══ BCDBoot ═══ -->
      <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_AdvOptions_BCDBootGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_BootVerbose_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_BootVerbose_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE946;}">
        <ToggleSwitch IsOn="{x:Bind VM.Advanced.EnableBootVerbose, Mode=TwoWay}" />
      </cc:SettingsCard>
      <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_AdvOptions_BootEx_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_AdvOptions_BootEx_Desc}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xEC7A;}">
        <ToggleSwitch IsOn="{x:Bind VM.Advanced.EnableBootEx, Mode=TwoWay}"
                        IsEnabled="{x:Bind VM.Advanced.IsBootExAvailable, Mode=OneWay}" />
      </cc:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
