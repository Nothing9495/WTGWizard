<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WTGWizard.Pages.Steps.ConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:cc="using:CommunityToolkit.WinUI.Controls"
      xmlns:ui="using:CommunityToolkit.WinUI"
      xmlns:lang="using:WTGWizard.Main.Language"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

  <ScrollViewer Padding="20,20,20,0">
    <StackPanel Margin="0,0,0,20" Spacing="32">
      <StackPanel Spacing="3">
        <!-- 标题 -->
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_Title}"
                   Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_Desc}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- ═══ 开始部署 ═══ -->
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_StartDeployGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_StartDeploy_Header}"
                         Description="{x:Bind lang:Lang.Page_WizStep_Confirm_StartDeploy_Desc}">
          <Button Content="{x:Bind lang:Lang.Page_WizStep_Confirm_StartDeployButton}"
                  Click="StartDeploy_Click"
                  IsEnabled="{x:Bind Display.IsStartDeployEnabled, Mode=OneWay}"
                  Style="{ThemeResource AccentButtonStyle}"/>
        </cc:SettingsCard>

        <!-- ═══ 映像信息 ═══ -->
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_ImageInfoGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
        <Expander IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  MinHeight="70">
          <Expander.Header>
            <Grid HorizontalAlignment="Stretch" Margin="1,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="20"
                        VerticalAlignment="Center" />

              <StackPanel Grid.Column="1" Margin="21,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_ImageInfoGroup}" FontSize="14.4" />
              </StackPanel>

              <TextBlock Grid.Column="2" FontSize="14.4" Opacity="0.7"
                         VerticalAlignment="Center"
                         Text="{x:Bind VM.Image.FilePath, Mode=OneWay}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="400" />
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="12" Padding="56,8,0,4">
            <!-- 长字段区 -->
            <Grid ColumnSpacing="16" RowSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_NameLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Text="{x:Bind Display.ImageName, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_DescLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Text="{x:Bind Display.ImageDescription, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" MaxLines="3"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_DispDescLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Text="{x:Bind Display.DisplayDescription, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" MaxLines="3"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>

            <!-- 短字段区 -->
            <Grid ColumnSpacing="16" RowSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_IndexLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.ImageIndex, Mode=OneWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_VersionLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.ImageVersion, Mode=OneWay}" />
              </StackPanel>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_FeatureLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.FeatureUpdate, Mode=OneWay}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_ArchLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.Architecture, Mode=OneWay}" />
              </StackPanel>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_BuildLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.BuildNumber, Mode=OneWay}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_SizeLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.ExpandedSizeDisplay, Mode=OneWay}" />
              </StackPanel>

              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_DateLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Display.DateCreated, Mode=OneWay}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Expander>

        <!-- ═══ 部署方式 ═══ -->
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_DeployMethodGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_MethodType_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE7B8;}">
          <TextBlock Text="{x:Bind Display.MethodType, Mode=OneWay}"
                     VerticalAlignment="Center" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_TargetDisk_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE88E;}">
          <TextBlock Text="{x:Bind Display.TargetDisk, Mode=OneWay}"
                     VerticalAlignment="Center" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_TargetPartition_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE74E;}"
                         Visibility="{x:Bind Display.TargetPartitionVisible, Mode=OneWay}">
          <TextBlock Text="{x:Bind Display.TargetPartition, Mode=OneWay}"
                     VerticalAlignment="Center" />
        </cc:SettingsCard>
        <cc:SettingsExpander Header="{x:Bind lang:Lang.Page_WizStep_Confirm_PartitionConfig_Header}"
                             HeaderIcon="{ui:FontIcon Glyph=&#xEBC4;}"
                             Visibility="{x:Bind Display.PartitionConfigVisible, Mode=OneWay}"
                             IsExpanded="True">
          <cc:SettingsExpander.Items>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_EspSize_Header}">
              <TextBlock Text="{x:Bind Display.EspSize, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_OsSize_Header}">
              <TextBlock Text="{x:Bind Display.OsSize, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_OsLabel_Header}">
              <TextBlock Text="{x:Bind Display.OsLabel, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_ReservedVolSize_Header}"
                             Visibility="{x:Bind Display.ReservedVolVisible, Mode=OneWay}">
              <TextBlock Text="{x:Bind Display.ReservedVolSize, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_ReservedVolFs_Header}"
                             Visibility="{x:Bind Display.ReservedVolVisible, Mode=OneWay}">
              <TextBlock Text="{x:Bind Display.ReservedVolFs, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_ReservedVolLabel_Header}"
                             Visibility="{x:Bind Display.ReservedVolVisible, Mode=OneWay}">
              <TextBlock Text="{x:Bind Display.ReservedVolLabel, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </cc:SettingsCard>
          </cc:SettingsExpander.Items>
        </cc:SettingsExpander>

        <!-- ═══ 部署选项 ═══ -->
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_DeployOptionsGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_HideLocalDisks_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xEDA2;}">
          <ToggleSwitch IsOn="{x:Bind VM.Options.HideLocalDisks, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_PreventEncryption_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE785;}">
          <ToggleSwitch IsOn="{x:Bind VM.Options.PreventDeviceEncryption, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_NoDefaultDriveLetter_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xECE4;}">
          <ToggleSwitch IsOn="{x:Bind VM.Options.NoDefaultDriveLetter, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_RemoveOsDriveLetter_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xED1A;}">
          <ToggleSwitch IsOn="{x:Bind VM.Options.AutoRemoveOsDriveLetter, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_UseDismToDeploy_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE756;}">
          <ToggleSwitch IsOn="{x:Bind VM.Options.UseDismToDeploy, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>

        <!-- ═══ 高级设置 ═══ -->
        <TextBlock Text="{x:Bind lang:Lang.Page_WizStep_Confirm_AdvancedGroup}"
                   FontSize="14"
                   Margin="0,12,0,6"
                   FontWeight="SemiBold"/>
        <cc:SettingsExpander Header="{x:Bind lang:Lang.Page_WizStep_Confirm_DriversIntegration_Header}"
                             HeaderIcon="{ui:FontIcon Glyph=&#xE958;}"
                             IsExpanded="{x:Bind VM.Advanced.DriverEnabled, Mode=OneWay}">
          <ToggleSwitch IsOn="{x:Bind VM.Advanced.DriverEnabled, Mode=OneWay}"
                        IsEnabled="False" />
          <cc:SettingsExpander.Items>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_DriversPath_Header}">
              <TextBlock Text="{x:Bind Display.DriverPathDisplay, Mode=OneWay}"
                         Width="350"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         HorizontalTextAlignment="Right"/>
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_UnsignedDrivers_Header}">
              <ToggleSwitch IsOn="{x:Bind Display.ForceUnsignedDisplay, Mode=OneWay}"
                            IsEnabled="False" />
            </cc:SettingsCard>
          </cc:SettingsExpander.Items>
        </cc:SettingsExpander>

        <cc:SettingsExpander Header="{x:Bind lang:Lang.Page_WizStep_Confirm_ImportAnswerFile_Header}"
                             HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}"
                             IsExpanded="{x:Bind VM.Advanced.CustomAnsFileEnabled, Mode=OneWay}">
          <ToggleSwitch IsOn="{x:Bind VM.Advanced.CustomAnsFileEnabled, Mode=OneWay}"
                        IsEnabled="False" />
          <cc:SettingsExpander.Items>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_AnswerFilePath_Header}">
              <TextBlock Text="{x:Bind Display.AnsFilePathDisplay, Mode=OneWay}"
                         Width="350"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         HorizontalTextAlignment="Right"/>
            </cc:SettingsCard>
            <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_CleanAnsFile_Header}">
              <ToggleSwitch IsOn="{x:Bind Display.CleanAnsFileDisplay, Mode=OneWay}"
                            IsEnabled="False" />
            </cc:SettingsCard>
          </cc:SettingsExpander.Items>
        </cc:SettingsExpander>

        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_BootVerbose_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xE946;}">
          <ToggleSwitch IsOn="{x:Bind VM.Advanced.EnableBootVerbose, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>
        <cc:SettingsCard Header="{x:Bind lang:Lang.Page_WizStep_Confirm_BootEx_Header}"
                         HeaderIcon="{ui:FontIcon Glyph=&#xEC7A;}">
          <ToggleSwitch IsOn="{x:Bind VM.Advanced.EnableBootEx, Mode=OneWay}"
                        IsEnabled="False" />
        </cc:SettingsCard>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
