<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WTGWizard.Pages.WizardHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:WTGWizard.Pages"
             xmlns:lang="using:WTGWizard.Main.Language"
             mc:Ignorable="d">

  <Grid MaxWidth="{StaticResource PageContentMaxWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 步骤内容区 -->
    <Frame Grid.Row="0"
           x:Name="StepFrame"
           HorizontalAlignment="Stretch"
           HorizontalContentAlignment="Stretch" />

    <!-- 底栏 -->
    <Border Grid.Row="1"
            Padding="24,12"
            Style="{StaticResource CardBorderStyle}"
            Margin="16,16,16,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StepIndicator"
                   Text="{x:Bind local:WizardHost.FormatStepIndicator(VM.CurrentStepTitle, VM.CurrentStep, VM.TotalSteps), Mode=OneWay}"
                   VerticalAlignment="Center"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button x:Name="BackButton"
                  Content="{x:Bind lang:Lang.Page_WizHost_BackButton_Content}"
                  Click="BackButton_Click" />
          <Button x:Name="ForwardButton"
                  Click="ForwardButton_Click"
                  Content="{x:Bind lang:Lang.Page_WizHost_ForwardButton_Content}"
                  Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
