<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WTGWizard.Pages.WizardHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:WTGWizard.Pages"
             xmlns:lang="using:WTGWizard.Main.Language"
             mc:Ignorable="d">

  <UserControl.Resources>
    <SolidColorBrush x:Key="FloatingBarBackgroundBrush"
           Color="{ThemeResource SystemChromeMediumLowColor}"
           Opacity="0.9"/>

    <Style x:Key="FloatingBarStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
      <Setter Property="Background" Value="{ThemeResource FloatingBarBackgroundBrush}" />
      <Setter Property="Shadow" Value="{StaticResource SharedShadow}" />
    </Style>
  </UserControl.Resources>

  <Grid MaxWidth="{StaticResource PageContentMaxWidth}">
    <!-- 步骤内容区 -->
    <Frame x:Name="StepFrame"
           HorizontalAlignment="Stretch"
           HorizontalContentAlignment="Stretch"/>

    <!-- 底栏 -->
    <Border Padding="24,12"
            Style="{StaticResource FloatingBarStyle}"
            CornerRadius="8"
            Margin="16,16,16,16"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StepIndicator"
                   Text="{x:Bind local:WizardHost.FormatStepIndicator(VM.CurrentStepTitle, VM.CurrentStep, VM.TotalSteps), Mode=OneWay}"
                   VerticalAlignment="Center"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button x:Name="BackButton"
                  Content="{x:Bind lang:Lang.Page_WizHost_BackButton_Content}"
                  Click="BackButton_Click" />
          <Button x:Name="ForwardButton"
                  Click="ForwardButton_Click"
                  Content="{x:Bind lang:Lang.Page_WizHost_ForwardButton_Content}"
                  Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
