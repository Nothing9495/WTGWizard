<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WTGWizard.Pages.TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uc="using:WTGWizard.UserControls"
      xmlns:models="using:WTGWizard.Main.DeploymentCore.Models"
      xmlns:lang="using:WTGWizard.Main.Language"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

  <Grid Padding="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="280" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>

    <!--  左侧：任务列表  -->
    <ScrollViewer Grid.Column="0" Padding="0,0,10,0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="8">
        <ItemsControl x:Name="TaskList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:DeployTaskItem">
              <uc:TaskContentCard Header="{x:Bind Title}"
                                  Description="{x:Bind Description}"
                                  Status="{x:Bind Status, Mode=OneWay}"
                                  ProgressValue="{x:Bind ProgressValue, Mode=OneWay}"
                                  Margin="0,0,0,8"
                                  CornerRadius="8"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!--  右侧：终端输出  -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  终端输出区域  -->
      <uc:TerminalBox x:Name="Terminal"
                      Grid.Row="0"
                      Margin="10,0,0,4" />

      <!--  底部工具栏  -->
      <Grid Grid.Row="1" Margin="10,0,0,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  磁盘性能面板  -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1" CornerRadius="8" Padding="12,4">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_NumberLabel}" VerticalAlignment="Center" Opacity="0.6" />
              <TextBlock x:Name="DiskNumText" Text="-" MinWidth="20"
                         HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_BusyLabel}" VerticalAlignment="Center" Opacity="0.6" />
              <TextBlock x:Name="DiskBusyText" Text="-" MinWidth="50"
                         HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_ReadWriteLabel}" VerticalAlignment="Center" Opacity="0.6" />
              <TextBlock x:Name="DiskReadWriteText" Text="-" MinWidth="150"
                         HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!--  终端功能 Toggle + 终止按钮  -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                  BorderBrush="{ThemeResource CardStrokeColorDefault}"
                  BorderThickness="1" CornerRadius="8" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Padding="4">
              <ToggleButton x:Name="WrapToggle" Content="{x:Bind lang:Lang.Page_Task_WrapToggle}" IsChecked="True"
                            Checked="WrapToggle_Changed" Unchecked="WrapToggle_Changed" />
              <ToggleButton x:Name="FreezeToggle" Content="{x:Bind lang:Lang.Page_Task_FreezeToggle}" IsChecked="False"
                            Checked="FreezeToggle_Changed" Unchecked="FreezeToggle_Changed" />
            </StackPanel>
          </Border>
          <Button x:Name="AbortButton" Content="{x:Bind lang:Lang.Page_Task_AbortButton}"
                  IsEnabled="{x:Bind VM.IsDeploying, Mode=OneWay}"
                  Click="AbortButton_Click"
                  VerticalAlignment="Stretch" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
