<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WTGWizard.Pages.TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uc="using:WTGWizard.UserControls"
      xmlns:models="using:WTGWizard.Main.DeploymentCore.Models"
      xmlns:lang="using:WTGWizard.Main.Language"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

  <Grid Padding="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="280" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>

    <!--  左侧：任务列表  -->
    <ScrollViewer Grid.Column="0" Padding="0,0,10,0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="8">
        <ItemsControl x:Name="TaskList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:DeployTaskItem">
              <uc:TaskContentCard Header="{x:Bind Title}"
                                  Description="{x:Bind Description}"
                                  Status="{x:Bind Status, Mode=OneWay}"
                                  ProgressValue="{x:Bind ProgressValue, Mode=OneWay}"
                                  Margin="0,0,0,8"
                                  CornerRadius="8"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!--  右侧：终端输出  -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  终端输出区域  -->
      <uc:TerminalBox x:Name="Terminal"
                      Grid.Row="0"
                      Margin="10,0,0,8" />

      <!--  底部工具栏  -->
      <Grid Grid.Row="1" Margin="10,0,0,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  磁盘性能面板  -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1" CornerRadius="8"
                Padding="12,6"
                HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Disk # -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_NumberLabel}"
                         FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
              <TextBlock x:Name="DiskNumText" Text="-" MinWidth="20" FontFamily="Cascadia Mono"
                         FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
            <!-- Disk Busy -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_BusyLabel}"
                         FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
              <TextBlock x:Name="DiskBusyText" Text="-" MinWidth="50" FontFamily="Cascadia Mono"
                         FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
            <!-- Disk R/W：双行布局（上读下写） -->
            <StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_ReadLabel}"
                           FontSize="11" Opacity="0.5" MinWidth="32" VerticalAlignment="Center" />
                <TextBlock x:Name="DiskReadText" Text="-" MinWidth="80" FontFamily="Cascadia Mono"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Bind lang:Lang.Page_Task_DiskPerf_WriteLabel}"
                           FontSize="11" Opacity="0.5" MinWidth="32" VerticalAlignment="Center" />
                <TextBlock x:Name="DiskWriteText" Text="-" MinWidth="80" FontFamily="Cascadia Mono"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!--  终端功能 Toggle + 终止按钮  -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                  BorderBrush="{ThemeResource CardStrokeColorDefault}"
                  BorderThickness="1" CornerRadius="8" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Padding="4">
              <ToggleButton x:Name="WrapToggle" Content="{x:Bind lang:Lang.Page_Task_WrapToggle}" IsChecked="True"
                            Checked="WrapToggle_Changed" Unchecked="WrapToggle_Changed" />
              <ToggleButton x:Name="FreezeToggle" Content="{x:Bind lang:Lang.Page_Task_FreezeToggle}" IsChecked="False"
                            Checked="FreezeToggle_Changed" Unchecked="FreezeToggle_Changed" />
              <Button x:Name="AbortButton" Content="{x:Bind lang:Lang.Page_Task_AbortButton}"
                      IsEnabled="{x:Bind VM.IsDeploying, Mode=OneWay}"
                      Style="{StaticResource AccentButtonStyle}"
                      Background="{ThemeResource SystemFillColorCriticalBrush}"
                      Click="AbortButton_Click"
                      VerticalAlignment="Stretch" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
