<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="WTGWizard.Pages.TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:cc="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="using:WTGWizard.Main.Language"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:WTGWizard.Main.DeploymentCore.Models"
      xmlns:uc="using:WTGWizard.UserControls"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

  <cc:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind HasDeployment, Mode=OneWay}">
    <cc:SwitchPresenter.SwitchCases>
      <!--  无任务：空状态（仿 WelcomePage 布局，无跳转按钮）  -->
      <cc:Case Value="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock HorizontalAlignment="Center" Style="{ThemeResource TitleLargeTextBlockStyle}" Text="{x:Bind lang:Lang.Page_Task_EmptyTitle}" />
          <TextBlock HorizontalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Style="{ThemeResource BodyTextBlockStyle}"
                     Text="{x:Bind lang:Lang.Page_Task_EmptyMsg}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </cc:Case>

      <!--  有任务：常规任务界面  -->
      <cc:Case Value="True">
        <Grid Padding="20" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>

          <!--  左侧：任务列表  -->
          <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="8">
              <ItemsControl x:Name="TaskList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DeployTaskItem">
                    <uc:TaskContentCard Margin="0,0,0,8"
                                        CornerRadius="8"
                                        Description="{x:Bind Description}"
                                        Header="{x:Bind Title}"
                                        ProgressValue="{x:Bind ProgressValue, Mode=OneWay}"
                                        Status="{x:Bind Status, Mode=OneWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!--  右侧：终端输出  -->
          <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  终端输出区域  -->
            <uc:TerminalBox x:Name="Terminal" Grid.Row="0" />

            <!--  底部工具栏  -->
            <Grid Grid.Row="1" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!--  磁盘性能面板  -->
              <Border Grid.Column="0"
                      Padding="12,6"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefault}"
                      BorderBrush="{ThemeResource CardStrokeColorDefault}"
                      BorderThickness="1"
                      CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <!--  Disk #  -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.5" Text="{x:Bind lang:Lang.Page_Task_DiskPerf_NumberLabel}" />
                    <TextBlock x:Name="DiskNumText"
                               Width="7"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="-" />
                  </StackPanel>
                  <Border Width="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <!--  Disk Busy  -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.5" Text="{x:Bind lang:Lang.Page_Task_DiskPerf_BusyLabel}" />
                    <TextBlock x:Name="DiskBusyText"
                               MinWidth="50"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="-" />
                  </StackPanel>
                  <Border Width="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <!--  Disk R/W：双行布局（上读下写）  -->
                  <StackPanel VerticalAlignment="Center" Orientation="Vertical" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock MinWidth="32"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Opacity="0.5"
                                 Text="{x:Bind lang:Lang.Page_Task_DiskPerf_ReadLabel}" />
                      <TextBlock x:Name="DiskReadText"
                                 MinWidth="80"
                                 VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Text="-" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock MinWidth="32"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Opacity="0.5"
                                 Text="{x:Bind lang:Lang.Page_Task_DiskPerf_WriteLabel}" />
                      <TextBlock x:Name="DiskWriteText"
                                 MinWidth="80"
                                 VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Text="-" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!--  终端功能 Toggle + 终止按钮  -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Border Padding="8,4"
                        Background="{ThemeResource CardBackgroundFillColorDefault}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel Padding="4" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="WrapToggle"
                                  Checked="WrapToggle_Changed"
                                  Content="{x:Bind lang:Lang.Page_Task_WrapToggle}"
                                  IsChecked="True"
                                  Unchecked="WrapToggle_Changed" />
                    <ToggleButton x:Name="FreezeToggle"
                                  Checked="FreezeToggle_Changed"
                                  Content="{x:Bind lang:Lang.Page_Task_FreezeToggle}"
                                  IsChecked="False"
                                  Unchecked="FreezeToggle_Changed" />
                    <Button x:Name="AbortButton"
                            VerticalAlignment="Stretch"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            Click="AbortButton_Click"
                            Content="{x:Bind lang:Lang.Page_Task_AbortButton}"
                            IsEnabled="{x:Bind VM.IsDeploying, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </cc:Case>
    </cc:SwitchPresenter.SwitchCases>
  </cc:SwitchPresenter>
</Page>
