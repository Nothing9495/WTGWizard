<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WTGWizard.Main.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WTGWizard.Main">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- XAML Constants -->
      <x:Double x:Key="PageContentMaxWidth">1250</x:Double>
      <x:Double x:Key="NavViewPaneBreakpoint">1350</x:Double>
      <!-- 底部内容边距步骤页内容高度，避免页面控件被底栏遮挡 -->
      <Thickness x:Key="PageContentBottomMargin">0,0,0,88</Thickness>
      <!-- 步骤页 ScrollViewer 公用 Padding / ConfirmPage 悬浮按钮抬升共用 -->
      <Thickness x:Key="StepPagePadding">36,40,36,0</Thickness>
      <Thickness x:Key="FloatingStartDeployButtonMargin">0,0,28,96</Thickness>

      <!-- 通用卡片外观：Card 主题背景/描边/圆角 4，供页面 Border 引用 -->
      <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>

      <!-- 确认页详情卡片：CardBorderStyle + 固定尺寸 -->
      <Style x:Key="DetailCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Width" Value="375" />
        <Setter Property="MinHeight" Value="162" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <!-- 卡片标题行文本（图标旁的 Caption，等效 CaptionTextBlockStyle + Opacity 0.7） -->
      <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      
      <!-- 悬浮元素投影（配合 Translation 使用） -->
      <ThemeShadow x:Key="SharedShadow" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
