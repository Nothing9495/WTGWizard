<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>preview</LangVersion>
		<RootNamespace>WTGWizard</RootNamespace>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64</Platforms>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<!-- <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants> -->
	</PropertyGroup>

	<PropertyGroup>
		<ApplicationIcon>Assets\AppLogo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- 图标同时嵌入为 .NET 资源，供运行时标题栏图标使用（无磁盘文件依赖） -->
		<EmbeddedResource Include="Assets\AppLogo.ico" LogicalName="WTGWizard.Assets.AppLogo.ico" />
		<Content Include="Assets\WinLogo\*.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\AppLogo.ico" CopyToOutputDirectory="PreserveNewest" />
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<!-- Referenced NuGet Packages -->
	<!-- WASDK 瘦身（替代裸 metapackage，省 AI/ML/Search/Widgets ~45MB 解压）：
	     - metapackage 2.4.0 保留为版本锚（CommunityToolkit 传递要求 >=1.6；ExcludeAssets="all"
	       使其仅参与版本解析、不导入 1.x 内嵌 WinUI targets，否则与子包 MSB4011 重复导入）
	     - 白名单五包正常引用（FileOpenPicker 位于 Foundation，勿移除；DWrite 保守保留）
	     - 黑名单四包（AI/ML/Search/Widgets，Main 源码零使用）保留依赖图一致性但
	       ExcludeAssets="all" 静默其 buildTransitive 复制（onnxruntime/DirectML 等）
	     - 升级 WASDK 时需重新对齐全部版本（见 AGENTS.md pitfall） -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
		<PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
		<PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.4.4" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.74" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.4.4" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Project References -->
	<ItemGroup>
		<ProjectReference Include="..\WTGWizard.Shared.Services\WTGWizard.Shared.Services.csproj" />
		<ProjectReference Include="..\WTGWizard.Shared.Common\WTGWizard.Shared.Common.csproj" />
		<ProjectReference Include="..\WTGWizard.Main.Language\WTGWizard.Main.Language.csproj" />
		<ProjectReference Include="..\WTGWizard.Main.DeploymentCore\WTGWizard.Main.DeploymentCore.csproj" />
	</ItemGroup>

	<!-- Copy WTGWizard.Worker Build Output -->
	<!-- WorkerOutputPath 含 Platform 段（CLI 全局 Platform）与不含 Platform 段（pubxml 内 Platform 晚于
	     OutputPath 公式求值，见 Pitfall 22）两种形态；用 **/Configuration 兼容两者 -->
	<Target Name="CopyWorkerBuildOutput" AfterTargets="Build">
		<ItemGroup>
			<WorkerOutputFiles Include="$(MSBuildProjectDirectory)\..\WTGWizard.Worker\bin\**\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\WTGWizard.Worker*" />
			<WorkerOutputFiles Include="$(MSBuildProjectDirectory)\..\WTGWizard.Worker\bin\**\$(Configuration)\$(TargetFramework)\WTGWizard.Worker*" />
		</ItemGroup>
		<Copy SourceFiles="@(WorkerOutputFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyWorkerBuildOutputToPublish" AfterTargets="Publish">
		<ItemGroup>
			<WorkerOutputFiles Include="$(MSBuildProjectDirectory)\..\WTGWizard.Worker\bin\**\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\WTGWizard.Worker*" />
			<WorkerOutputFiles Include="$(MSBuildProjectDirectory)\..\WTGWizard.Worker\bin\**\$(Configuration)\$(TargetFramework)\WTGWizard.Worker*" />
		</ItemGroup>
		<Copy SourceFiles="@(WorkerOutputFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
