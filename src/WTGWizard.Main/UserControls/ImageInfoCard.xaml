<UserControl
    x:Class="WTGWizard.UserControls.ImageInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="using:WTGWizard.Main.Language"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userc="using:WTGWizard.UserControls"
    mc:Ignorable="d">

  <UserControl.Resources>
    <Style x:Key="ImageInfoCaptionTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <Border MinHeight="230"
          Padding="24"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="4">
    <Grid>
      <!--  四态：未选择 / 加载中 / 已选择且正常 / 已选择但打开失败  -->
      <cc:SwitchPresenter TargetType="userc:ImageInfoCardState" Value="{x:Bind CardState, Mode=OneWay}">

        <!--  未选择映像  -->
        <cc:Case Value="NoImage">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <StackPanel.Transitions>
              <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="False" />
              </TransitionCollection>
            </StackPanel.Transitions>
            <TextBlock HorizontalAlignment="Center" Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_EmptyTitle}" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_EmptyHint}" />
          </StackPanel>
        </cc:Case>

        <!--  加载中  -->
        <cc:Case Value="Loading">
          <Border Background="{ThemeResource ControlSolidFillColorDefaultBrush}" CornerRadius="8">
            <Border.Transitions>
              <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="False" />
              </TransitionCollection>
            </Border.Transitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <ProgressRing Width="40" Height="40" Foreground="{ThemeResource AccentFillColorDefaultBrush}" IsIndeterminate="True" />
              <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_Loading}" />
            </StackPanel>
          </Border>
        </cc:Case>

        <!--  已选择映像但打开失败  -->
        <cc:Case Value="Error">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <StackPanel.Transitions>
              <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="False" />
              </TransitionCollection>
            </StackPanel.Transitions>
            <TextBlock HorizontalAlignment="Center" Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_ErrorTitle}" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_ErrorHint}" />
          </StackPanel>
        </cc:Case>

        <!--  已选择映像且正常（信息面板）  -->
        <cc:Case Value="Normal">
          <Grid MinWidth="750" MaxWidth="880" HorizontalAlignment="Center" ColumnSpacing="24">
            <Grid.Transitions>
              <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="False" />
              </TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Logo  -->
            <Grid Grid.Column="0" Width="256" Height="144" VerticalAlignment="Center">
              <Image MaxWidth="256"
                     MaxHeight="144"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_Logo}"
                     Source="{x:Bind LogoSource, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="12">
              <Grid VerticalAlignment="Bottom" ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row 0: Name | Description  -->
                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             VerticalAlignment="Top"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Style="{StaticResource ImageInfoCaptionTextStyle}"
                             Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_NameLabel}" />
                  <TextBlock Grid.Column="1"
                             MaxLines="2"
                             Style="{StaticResource ImageInfoCaptionTextStyle}"
                             Text="{x:Bind ImageName, Mode=OneWay, FallbackValue='-'}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="WrapWholeWords" />
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             VerticalAlignment="Top"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Style="{StaticResource ImageInfoCaptionTextStyle}"
                             Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_DescLabel}" />
                  <TextBlock Grid.Column="1"
                             MaxLines="3"
                             Style="{StaticResource ImageInfoCaptionTextStyle}"
                             Text="{x:Bind ImageDescription, Mode=OneWay, FallbackValue='-'}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="WrapWholeWords" />
                </Grid>

                <!--  Row 1: Display Description  -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             VerticalAlignment="Top"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Style="{StaticResource ImageInfoCaptionTextStyle}"
                             Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_DispDescLabel}" />
                  <TextBlock Grid.Column="1"
                             MaxLines="3"
                             Style="{StaticResource ImageInfoCaptionTextStyle}"
                             Text="{x:Bind DisplayDescription, Mode=OneWay, FallbackValue='-'}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="WrapWholeWords" />
                </Grid>
              </Grid>

              <Grid VerticalAlignment="Bottom" ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row 0: 索引 | 版本  -->
                <Grid Grid.Row="0" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_IndexLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind ImageIndex, Mode=OneWay, FallbackValue='-'}" />
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_VersionLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind ImageVersion, Mode=OneWay, FallbackValue='-'}" />
                </Grid>

                <!--  Row 1: 功能更新 | 架构  -->
                <Grid Grid.Row="1" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_FeatureLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind FeatureUpdate, Mode=OneWay, FallbackValue='-'}" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_ArchLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind Architecture, Mode=OneWay, FallbackValue='-'}" />
                </Grid>

                <!--  Row 2: 构建号 | 展开大小  -->
                <Grid Grid.Row="2" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_BuildLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind BuildNumber, Mode=OneWay, FallbackValue='-'}" />
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_SizeLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind ExpandedSize, Mode=OneWay, FallbackValue='-'}" />
                </Grid>

                <!--  Row 3: 创建日期  -->
                <Grid Grid.Row="3" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind lang:Lang.UsrCtrl_ImageInfoCard_DateLabel}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ImageInfoCaptionTextStyle}" Text="{x:Bind DateCreated, Mode=OneWay, FallbackValue='-'}" />
                </Grid>
              </Grid>
            </StackPanel>
          </Grid>
        </cc:Case>
      </cc:SwitchPresenter>
    </Grid>
  </Border>
</UserControl>
