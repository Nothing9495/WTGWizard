<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WTGWizard.UserControls.InfoBarPresenter"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <InfoBar
      x:Name="InnerInfoBar"
      Title="{x:Bind Info.Title, Mode=OneWay}"
      Message="{x:Bind Info.Message, Mode=OneWay}"
      Severity="{x:Bind Info.Severity, Mode=OneWay}"
      IsOpen="{x:Bind Info.IsOpen, Mode=OneWay, FallbackValue=False}"
      IsClosable="{x:Bind Info.IsClosable, Mode=OneWay, FallbackValue=True}"
      IsIconVisible="{x:Bind InfoBarIsIconVisible, Mode=OneWay}"
      Closed="InnerInfoBar_Closed">
    <InfoBar.ActionButton>
      <Button x:Name="ActionButton"
          Content="{x:Bind Info.ActionContent, Mode=OneWay}" />
    </InfoBar.ActionButton>
  </InfoBar>
</UserControl>
